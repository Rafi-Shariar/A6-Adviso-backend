<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mentorship Application Approved - Adviso</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; color: #1e293b;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #f8fafc; padding: 40px 15px;">
      <tr>
        <td align="center">
          <!-- Main Container -->
          <table role="presentation" width="100%" style="max-width: 520px; background-color: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);" cellspacing="0" cellpadding="0" border="0">
            
            <!-- Header Accent Bar -->
            <tr>
              <td style="height: 6px; background: linear-gradient(90deg, #4f46e5, #06b6d4);"></td>
            </tr>

            <!-- Content Area -->
            <tr>
              <td style="padding: 36px 40px;">
                
                <!-- Brand / Logo Area -->
                <div style="font-size: 22px; font-weight: 800; letter-spacing: -0.5px; color: #0f172a; margin-bottom: 24px;">
                  Adviso<span style="color: #4f46e5;">.</span>
                </div>

                <!-- Approval Status Badge -->
                <div style="display: inline-block; padding: 6px 12px; background-color: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 20px; margin-bottom: 16px;">
                  <span style="font-size: 12px; font-weight: 600; color: #059669;">
                    ✓ Application Approved
                  </span>
                </div>

                <!-- Headline -->
                <h1 style="margin: 0 0 12px 0; font-size: 22px; font-weight: 700; color: #0f172a; letter-spacing: -0.3px;">
                  Congratulations, <%= name %>!
                </h1>
                
                <p style="margin: 0 0 24px 0; font-size: 15px; line-height: 24px; color: #475569;">
                  We have reviewed your profile and are thrilled to welcome you as an official mentor on Adviso. Your expertise will be invaluable in shaping the careers of ambitious learners across the community.
                </p>

                <!-- Next Steps Card -->
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin: 24px 0; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px 20px;">
                  <tr>
                    <td>
                      <span style="display: block; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #64748b; margin-bottom: 12px;">
                        Quick setup checklist:
                      </span>
                      <p style="margin: 0 0 10px 0; font-size: 14px; line-height: 20px; color: #334155;">
                        🗓️ <strong>Set Availability:</strong> Open up weekly consultation slots synced with your calendar.
                      </p>
                      <p style="margin: 0 0 10px 0; font-size: 14px; line-height: 20px; color: #334155;">
                        ✨ <strong>Polish Your Profile:</strong> Highlight your primary domains, tech stacks, and session topics.
                      </p>
                      <p style="margin: 0; font-size: 14px; line-height: 20px; color: #334155;">
                        💬 <strong>Receive Inquiries:</strong> Start accepting mentorship requests directly from your dashboard.
                      </p>
                    </td>
                  </tr>
                </table>

                <p style="margin: 24px 0 0 0; font-size: 13px; line-height: 20px; color: #64748b; text-align: center;">
                  Ready to get started? Log in to your Adviso mentor dashboard anytime to configure your settings.
                </p>

              </td>
            </tr>

            <!-- Footer Area -->
            <tr>
              <td style="background-color: #f8fafc; border-top: 1px solid #e2e8f0; padding: 24px 40px; text-align: center;">
                <p style="margin: 0 0 6px 0; font-size: 12px; color: #94a3b8;">
                  &copy; 2026 Adviso. All rights reserved.
                </p>
                <p style="margin: 0; font-size: 12px; color: #94a3b8;">
                  You received this email because you submitted a mentor application on Adviso.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>