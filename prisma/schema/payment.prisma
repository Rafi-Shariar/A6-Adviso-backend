model Payment {
    paymentId     String @id @default(uuid())
    transactionId String @unique

    sessionId String  @unique
    session   Session @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade, onUpdate: Cascade)

    amount Decimal @db.Decimal(10, 2)
    method String  @default("BKASH")

    bkashPaymentId String? @unique
    bkashTrxId     String?
    payerReference String?
    paidAt         String?

    platformCharge Decimal? @db.Decimal(10, 2)
    mentorEarnings Decimal? @db.Decimal(10, 2)

    status          PaymentStatus @default(PENDING)
    gatewayResponse Json?

    refundTrxId  String?
    refundAmount Decimal? @db.Decimal(10, 2)
    refundReason String?
    refundedAt   String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("payments")
}
